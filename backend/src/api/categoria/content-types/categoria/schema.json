{
  "kind": "collectionType",
  "collectionName": "categorias",
  "info": {
    "singularName": "categoria",
    "pluralName": "categorias",
    "displayName": "Categorías",
    "description": "Clasificación de productos por tipo (Moto, Piloto o Universal)"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "nombre": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "nombre",
      "required": true
    },
    "tipo": {
      "type": "enumeration",
      "enum": ["MOTO", "PILOTO", "UNIVERSAL"],
      "required": true
    },
    "descripcion": {
      "type": "text"
    }
  }
}
