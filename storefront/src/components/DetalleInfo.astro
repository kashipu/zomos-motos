---
import { ShieldCheck, Truck, Headphones } from "lucide-react";
import TablaCompatibilidad from "./TablaCompatibilidad.astro";

interface Props {
  nombre: string;
  marca?: string;
  precio: number;
  descuento?: number;
  referencia: string;
  categoria?: string;
  compatibilidad?: {
    marca?: string;
    modelo?: string;
  };
}

const {
  nombre,
  marca = "Premium Brand",
  precio,
  descuento = 0,
  referencia,
  categoria = "Accesorios",
  compatibilidad,
} = Astro.props;

const tieneDescuento = descuento > 0;
const precioFinal = tieneDescuento ? Math.round(precio * (1 - descuento / 100)) : precio;
---

<div class="flex flex-col gap-8 lg:col-span-5">
  <div class="space-y-4">
    <div class="flex items-center gap-2">
      <span class="text-primary font-bold text-xs tracking-[0.3em] uppercase"
        >{marca}</span
      >
      <div class="h-px flex-1 bg-white/10"></div>
    </div>

    <h1
      class="text-white text-4xl md:text-5xl font-bold leading-tight tracking-tight font-display"
    >
      {nombre}
    </h1>

    <div class="flex items-center gap-6">
      <span class="text-zinc-400 text-xs font-bold uppercase tracking-widest"
        >REF: {referencia}</span
      >
    </div>
  </div>

  <div class="space-y-6">
    <div class="flex items-baseline gap-4 flex-wrap">
      {tieneDescuento ? (
        <>
          <span class="text-4xl font-bold text-white tracking-tighter">
            ${precioFinal.toLocaleString("es-CO")}
          </span>
          <span class="text-xl text-zinc-500 line-through">
            ${(precio || 0).toLocaleString("es-CO")}
          </span>
          <span class="px-3 py-1 bg-green-600/20 text-green-400 text-[10px] font-bold rounded-full border border-green-600/30 uppercase tracking-tighter">
            -{descuento}%
          </span>
        </>
      ) : (
        <span class="text-4xl font-bold text-white tracking-tighter">
          ${(precio || 0).toLocaleString("es-CO")}
        </span>
      )}
      <span
        class="px-3 py-1 bg-primary/10 text-primary text-[10px] font-bold rounded-full border border-primary/20 uppercase tracking-tighter"
      >
        En Stock
      </span>
    </div>

    <!-- Componente de Compatibilidad -->
    {
      compatibilidad && (
        <TablaCompatibilidad
          marca={compatibilidad.marca}
          modelo={compatibilidad.modelo}
        />
      )
    }
  </div>

  <!-- Slots para botones de compra (React components en la página) -->
  <div class="flex flex-col gap-4 pt-4">
    <slot name="buy-actions" />
  </div>

  <!-- Beneficios Rápidos -->
  <div class="grid grid-cols-3 gap-2 pt-6 border-t border-white/10">
    <div
      class="flex flex-col items-center justify-center p-4 bg-card-dark/40 rounded-xl border border-white/10 text-center group hover:border-primary/30 transition-all"
    >
      <Truck
        size={20}
        className="text-primary mb-2 group-hover:scale-110 transition-transform"
      />
      <span
        class="text-[9px] font-bold text-zinc-400 uppercase tracking-tighter"
        >Envío Global</span
      >
    </div>
    <div
      class="flex flex-col items-center justify-center p-4 bg-card-dark/40 rounded-xl border border-white/10 text-center group hover:border-primary/30 transition-all"
    >
      <ShieldCheck
        size={20}
        className="text-primary mb-2 group-hover:scale-110 transition-transform"
      />
      <span
        class="text-[9px] font-bold text-zinc-400 uppercase tracking-tighter"
        >100% Original</span
      >
    </div>
    <div
      class="flex flex-col items-center justify-center p-4 bg-card-dark/40 rounded-xl border border-white/10 text-center group hover:border-primary/30 transition-all"
    >
      <Headphones
        size={20}
        className="text-primary mb-2 group-hover:scale-110 transition-transform"
      />
      <span
        class="text-[9px] font-bold text-zinc-400 uppercase tracking-tighter"
        >Soporte Pro</span
      >
    </div>
  </div>
</div>


