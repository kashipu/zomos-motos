---
import Layout from "@/layouts/Layout.astro";
import { fetchProductoBySlug, fetchRelacionados, getStrapiMedia, getImageUrl, compatibilidadTexto } from "@/lib/strapi";
import AddToCart from "@/components/AddToCart";
import WhatsAppButton from "@/components/WhatsAppButton";
import ProductSEO from "@/components/ProductSEO.astro";
import MigasPan from "@/components/MigasPan.astro";
import GaleriaImagenes from "@/components/GaleriaImagenes.astro";
import DetalleInfo from "@/components/DetalleInfo.astro";
import FichaTecnica from "@/components/FichaTecnica.astro";
import TarjetaProducto from "@/components/TarjetaProducto.astro";

export const prerender = false;

const { slug } = Astro.params;

if (!slug) return Astro.redirect("/404");

const product = await fetchProductoBySlug(slug);

if (!product) return Astro.redirect("/404");

const relatedProducts = await fetchRelacionados(product);

// Breadcrumbs con tipo contextual
const tipoLabel = product.tipo === "moto" ? "Para tu Moto" : product.tipo === "piloto" ? "Para el Piloto" : null;
const breadcrumbs: { nombre: string; href?: string }[] = [];

if (tipoLabel) {
  breadcrumbs.push({
    nombre: tipoLabel,
    href: `/productos?type=${product.tipo}`,
  });
}

if (product.categoria) {
  const catParams = product.tipo
    ? `?type=${product.tipo}&categoria=${product.categoria.slug}`
    : `?categoria=${product.categoria.slug}`;
  breadcrumbs.push({
    nombre: product.categoria.nombre || "Categoría",
    href: `/productos${catParams}`,
  });
}
breadcrumbs.push({ nombre: product.nombre });

// Gallery
const gallery =
  product.imagenes?.map((img) => ({
    url: getStrapiMedia(img.url) ?? undefined,
    alt: product.nombre,
  })) || [];

// Compatibility info for DetalleInfo
const compatTexto = product.compatibilidades?.length
  ? compatibilidadTexto(product.compatibilidades)
  : undefined;

const compatibility =
  product.tipo === "moto" && product.compatibilidades?.length
    ? {
        marca: product.compatibilidades[0]?.marca_moto?.nombre || "Universal",
        modelo: compatTexto || "Todos los modelos",
      }
    : undefined;
---

<Layout title={product.nombre}>
  <ProductSEO
    slot="head"
    product={{
      ...product,
      nombre: product.nombre,
      slug: product.slug,
      descripcion: product.descripcion || "Descripción del producto",
      precio: product.precio,
      imagenes: product.imagenes || [],
    }}
  />

  <main class="max-w-[1280px] mx-auto px-6 lg:px-10 py-12">
    <MigasPan items={breadcrumbs} />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20">
      <GaleriaImagenes imagenes={gallery} />

      <DetalleInfo
        nombre={product.nombre}
        marca={product.marca?.nombre || "Zomos Motos"}
        precio={product.precio}
        descuento={product.descuento}
        referencia={product.referencia || "REF-000"}
        compatibilidad={compatibility}
      >
        <div slot="buy-actions" class="flex flex-col gap-4">
          <AddToCart
            client:load
            product={{
              id: String(product.id),
              nombre: product.nombre,
              precio: product.precio,
              descuento: product.descuento,
              sku: product.referencia || "REF-000",
              imagen: gallery[0]?.url,
              tipo: product.tipo,
              marca: product.marca?.nombre,
              variantes: product.variantes,
              compatibilidadTexto: compatTexto,
            }}
          />

          <WhatsAppButton
            client:load
            productName={product.nombre}
            sku={product.referencia}
          />
        </div>
      </DetalleInfo>
    </div>

    <FichaTecnica descripcion={product.descripcion} />

    {
      relatedProducts.length > 0 && (
        <section class="mt-32">
          <div class="flex items-center justify-between mb-12">
            <h2 class="text-3xl font-black text-white uppercase tracking-tight font-display">
              También <span class="text-primary">te puede interesar</span>
            </h2>
            <a
              href="/productos"
              class="text-zinc-400 hover:text-white transition-colors text-xs font-bold uppercase tracking-widest"
            >
              Ver catálogo completo
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
            {relatedProducts.map((p) => (
              <TarjetaProducto
                nombre={p.nombre}
                precio={p.precio}
                descuento={p.descuento}
                categoria={p.categoria?.nombre || "Premium"}
                compatibilidad={p.compatibilidades?.length ? compatibilidadTexto(p.compatibilidades) : undefined}
                imagen={getImageUrl(p)}
                slug={p.slug}
                tipo={p.tipo}
              />
            ))}
          </div>
        </section>
      )
    }
  </main>
</Layout>
